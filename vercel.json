      "destination": "/tools/index.html"
    },
    {
      "source": "/tools/token-creator",
      "destination": "/tools/token-creator/index.html"
    },
    {
      "source": "/tools/pons-v2",
      "destination": "/tools/pons-v2/index.html"
    },
    {
      "source": "/tools/multisender",
      "destination": "/tools/multisender/index.html"
    },
    {
      "source": "/tools/revoke",
      "destination": "/tools/revoke/index.html"
    },
    {
      "source": "/tools/mint",
      "destination": "/tools/mint/index.html"
    },
    {
      "source": "/tools/burn",
      "destination": "/tools/burn/index.html"
    },
    {
      "source": "/tools/create-pool",
      "destination": "/tools/create-pool/index.html"
    },
    {
      "source": "/tools/add-liquidity",
      "destination": "/tools/add-liquidity/index.html"
    },
    {
      "source": "/tools/remove-liquidity",
      "destination": "/tools/remove-liquidity/index.html"
    },
    {
      "source": "/tools/pause",
      "destination": "/tools/pause/index.html"
    },
    {
      "source": "/tools/unpause",
      "destination": "/tools/unpause/index.html"
    },
    {
      "source": "/tools/block",
      "destination": "/tools/block/index.html"
    },
    {
      "source": "/tools/unblock",
      "destination": "/tools/unblock/index.html"
    },
    {
      "source": "/tools/token-page",
      "destination": "/tools/token-page/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "routes": []
}